@techreport{iec61850-5,
  author      = {{IEC}},
  title       = {Communication Networks and Systems for Power Utility Automation --
                 Part 5: Communication Requirements for Functions and Device Models},
  number      = {IEC 61850-5},
  institution = {International Electrotechnical Commission},
  note        = {verified-secondary, through vendor and review literature only.
