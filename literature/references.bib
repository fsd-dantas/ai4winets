%
% DOIs are included only where confirmed. An absent DOI means it was not verified,
% not that none exists.

@article{wu2003effective,
  author  = {Wu, Dapeng and Negi, Rohit},
  title   = {Effective Capacity: A Wireless Link Model for Support of Quality of Service},
  journal = {IEEE Transactions on Wireless Communications},
  volume  = {2},
  number  = {4},
  pages   = {630--643},
  month   = jul,
  year    = {2003},
  note    = {verified-secondary. Link-layer channel model expressed in terms of data rate,
             delay and delay-violation probability. Source of the probabilistic
             delay-bound form used in this repository.}
}

@article{bennis2018urllc,
  author  = {Bennis, Mehdi and Debbah, M{\'e}rouane and Poor, H. Vincent},
  title   = {Ultrareliable and Low-Latency Wireless Communication: Tail, Risk, and Scale},
  journal = {Proceedings of the IEEE},
  volume  = {106},
  number  = {10},
  pages   = {1834--1853},
  month   = oct,
  year    = {2018},
  doi     = {10.1109/JPROC.2018.2867029},
  note    = {verified-secondary. Preprint at arXiv:1801.01270. Argues that reliability
