@techreport{3gpp22261,
  author      = {{3GPP}},
  title       = {Service Requirements for the 5G System},
  number      = {TS 22.261},
  institution = {3rd Generation Partnership Project},
  year        = {2022},
  note        = {verified-secondary, via ETSI TS 122 261 V17.11.0 (2022-10), Release 17.
                 Defines reliability as the percentage of packets successfully delivered
                 to a given system entity within the time constraint required by the
                 targeted service. Confirm the clause number and wording against the
                 release actually cited; the definition is stable across Releases 15--17
                 but the numbering is not guaranteed to be.}
}

